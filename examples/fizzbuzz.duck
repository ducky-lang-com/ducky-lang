// fizzbuzz.duck - the classic loop / modulo / branch demo.
fn main() -> int {
    let i = 1;
    while i <= 100 {
        if i % 15 == 0 {
            serve("FizzBuzz");
        } else if i % 3 == 0 {
            serve("Fizz");
        } else if i % 5 == 0 {
            serve("Buzz");
        } else {
            serve(i);
        }
        i = i + 1;
    }
    send 0;
}
