// fizzbuzz.duck - the classic loop / modulo / branch demo.
wing main() -> int {
    nest i = 1;
    while i <= 100 {
        when i % 15 == 0 {
            serve("FizzBuzz");
        } otherwise when i % 3 == 0 {
            serve("Fizz");
        } otherwise when i % 5 == 0 {
            serve("Buzz");
        } otherwise {
            serve(i);
        }
        i = i + 1;
    }
    send 0;
}
