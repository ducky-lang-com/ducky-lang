// examples/structs.duck - struct declarations, construction and fields.
struct Point {
    x: int,
    y: int,
}

fn move(p: Point, dx: int, dy: int) -> Point {
    send Point(p.x + dx, p.y + dy);
}

fn main() -> int {
    let p = Point(2, 3);
    serve(p.x);
    serve(p.y);

    p.x = 10;
    serve(p.x);

    // move() builds a fresh value; `let r = p` would instead share p's block
    let q = move(p, 5, 7);
    serve(q.x);        // 15
    serve(q.y);        // 10
    send 0;
}
