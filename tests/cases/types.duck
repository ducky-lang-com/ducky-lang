// types.duck - explicit annotations and inferred types.
wing main() -> int {
    nest a: int = 5;
    nest b: bool = true;
    nest c: string = "duck";
    nest d = 6;
    nest e = false;

    serve(a);
    serve(b);
    serve(c);
    serve(d);
    serve(e);
    serve(-a);
    serve(!b);
    send 0;
}
