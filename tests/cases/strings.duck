// strings.duck - literals, escapes and value comparison.
wing main() -> int {
    serve("hello");
    serve("with\ttab");
    serve("quote: \"duck\"");
    serve("line1\nline2");

    nest a = "duck";
    nest b = "duck";
    nest c = "goose";
    serve(a == b);
    serve(a == c);
    serve(a != c);
    serve(a == "duck");
    send 0;
}
