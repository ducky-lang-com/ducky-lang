// grad_fd.duck - a finite-difference check of grad().
//
// The backward pass is written out by the compiler, so it has to be checked
// against something that is not itself the backward pass. For each component
// of each gradient this program also evaluates f at the two points either
// side of it, forms (f+ - f-) / 2h, and reports whether the two agree to a
// part in a thousand. A wrong rule shows up as `false`, not as a number you
// have to eyeball.

fn chain(w: tensor[4]) -> float {
    let d = tensor([4], [2.0, 4.0, 5.0, 8.0]);
    let a = sigmoid(w);
    let b = tanh(a);
    let c = gelu(b);
    let r = relu(w);
    let n = w / d;
    /* The `* 0.5` matters: it makes the gradient arriving at `gelu` something
     * other than all ones, so a rule that forgot to scale by it would fail
     * here instead of accidentally passing. */
    send sum(c) * 0.5 + sum(r) * 0.5 + sum(n) - sum(w) * 0.25 +
          cross_entropy(w, 2);
}

fn layer(m: tensor[2, 2]) -> float {
    let x = tensor([2], [0.5, -1.5]);
    let h = matmul(m, x);
    let c = matmul(m, m);
    let want = tensor([2, 2], [1.0, 0.0, 0.0, 1.0]);
    send sum(h * h) * 0.5 + mse(c, want);
}

fn close(a: float, b: float) -> bool {
    let d = a - b;
    send d * d < 0.000000000001;
}

fn main() -> int {
    let w: tensor[4] = tensor([4], [1.0, -0.5, 0.7, 2.0]);
    let m: tensor[2, 2] = tensor([2, 2], [1.0, 2.0, 3.0, 4.0]);
    let h = 0.000001;
    let gw = grad(chain, w);
    let gm = grad(layer, m);

    serve(close(gw[0], (chain(tensor([4], [1.000001, -0.5, 0.7, 2.0])) -
                        chain(tensor([4], [0.999999, -0.5, 0.7, 2.0]))) /
                       (2.0 * h)));
    serve(close(gw[1], (chain(tensor([4], [1.0, -0.499999, 0.7, 2.0])) -
                        chain(tensor([4], [1.0, -0.500001, 0.7, 2.0]))) /
                       (2.0 * h)));
    serve(close(gw[2], (chain(tensor([4], [1.0, -0.5, 0.700001, 2.0])) -
                        chain(tensor([4], [1.0, -0.5, 0.6999989999999999, 2.0]))) /
                       (2.0 * h)));
    serve(close(gw[3], (chain(tensor([4], [1.0, -0.5, 0.7, 2.000001])) -
                        chain(tensor([4], [1.0, -0.5, 0.7, 1.999999]))) /
                       (2.0 * h)));

    serve(close(gm[0][0], (layer(tensor([2, 2], [1.000001, 2.0, 3.0, 4.0])) -
                           layer(tensor([2, 2], [0.999999, 2.0, 3.0, 4.0]))) /
                          (2.0 * h)));
    serve(close(gm[0][1], (layer(tensor([2, 2], [1.0, 2.000001, 3.0, 4.0])) -
                           layer(tensor([2, 2], [1.0, 1.999999, 3.0, 4.0]))) /
                          (2.0 * h)));
    serve(close(gm[1][0], (layer(tensor([2, 2], [1.0, 2.0, 3.000001, 4.0])) -
                           layer(tensor([2, 2], [1.0, 2.0, 2.999999, 4.0]))) /
                          (2.0 * h)));
    serve(close(gm[1][1], (layer(tensor([2, 2], [1.0, 2.0, 3.0, 4.000001])) -
                           layer(tensor([2, 2], [1.0, 2.0, 3.0, 3.999999]))) /
                          (2.0 * h)));

    send 0;
}
