// bitwise.duck - &, |, ^, ~, <<, >> with C-style precedence.
fn main() -> int {
    serve(6 & 3);         // 2
    serve(6 | 3);         // 7
    serve(6 ^ 3);         // 5
    serve(~0);            // -1
    serve(~5);            // -6
    serve(1 << 4);        // 16
    serve(-16 >> 2);      // -4 (arithmetic shift)
    // NOTE: `5 & 3 == 1` parses as 5 & (3 == 1) and is a TYPE error in Duck:
    // there is no bool -> int promotion (see errors/bitwise_types.duck).
    serve((5 & 3) == 1);  // true: 5 & 3 == 1; parens are required
    serve(1 + 2 << 2);    // (1 + 2) << 2 -> 12: + binds tighter than <<
    serve(2 << 1 + 1);    // 2 << (1 + 1) -> 8
    serve(3 & 6 | 8 ^ 1); // (3 & 6) | (8 ^ 1) -> 11: & > ^ > |
    serve((~0) + 1);      // 0
    serve(128 >> 4 & 3);  // (128 >> 4) & 3 -> 0
    send 0;
}
