// forloop.duck - for i in a..b (a inclusive, b exclusive).
fn main() -> int {
    let sum = 0;
    for i in 1 .. 5 {
        sum = sum + i;
    }
    serve(sum); // 10: 1+2+3+4

    let n = 0;
    for i in 0 .. 10 {
        if i % 2 == 0 {
            continue;
        }
        n = n + i;
        if i == 7 {
            break;
        }
    }
    serve(n); // 16: 1+3+5+7

    let empty = 0;
    for i in 5 .. 5 {
        empty = empty + 1;
    }
    serve(empty); // 0: the range is empty

    let pairs = 0;
    for a in 0 .. 3 {
        for b in 0 .. 3 {
            pairs = pairs + a * b;
        }
    }
    serve(pairs); // 9: nested loops

    let counted = 0;
    let top = 3;
    for i in 0 .. top + 1 { // bounds are expressions, evaluated once
        counted = counted + 1;
    }
    serve(counted); // 4
    send 0;
}
