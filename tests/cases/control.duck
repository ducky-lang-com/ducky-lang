// control.duck - when / otherwise when / otherwise and while loops.
wing main() -> int {
    nest x = 10;
    when x > 5 {
        serve("big");
    } otherwise {
        serve("small");
    }

    when x == 10 {
        serve("ten");
    } otherwise when x == 9 {
        serve("nine");
    } otherwise {
        serve("other");
    }

    nest i = 0;
    nest sum = 0;
    while i < 5 {
        sum = sum + i;
        i = i + 1;
    }
    serve(sum);

    while false {
        serve("never");
    }

    when !false {
        serve("not false");
    }

    when true {
        when x == 10 {
            serve("nested");
        }
    }
    send 0;
}
