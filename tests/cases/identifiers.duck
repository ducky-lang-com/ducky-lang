// identifiers.duck - the retired words (wing, nest, when, otherwise) are
// ordinary identifiers, and so are words that merely contain them.
fn main() -> int {
    let wing = 1;
    let nest = wing + 1;
    let when = nest + 1;
    let otherwise = when + 1;
    let wingman = otherwise + 1;
    let nested = wingman + 1;
    let returns = nested + 1;
    let println = returns + 1;

    serve(wing);      // 1
    serve(nest);      // 2
    serve(when);      // 3
    serve(otherwise); // 4
    serve(wingman);   // 5
    serve(nested);    // 6
    serve(returns);   // 7
    serve(println);   // 8
    send 0;
}
