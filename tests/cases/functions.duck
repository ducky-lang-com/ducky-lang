// functions.duck - calls, parameters, values sent back and recursion.
fn add(a: int, b: int) -> int {
    send a + b;
}

fn fib(n: int) -> int {
    if n < 2 {
        send n;
    }
    send fib(n - 1) + fib(n - 2);
}

fn describe(name: string) -> string {
    send name;
}

fn nothing() {
    serve("nothing");
}

fn main() -> int {
    serve(add(2, 40));
    serve(fib(20));
    serve(describe("duck"));
    nothing();
    let v = add(fib(10), fib(5));
    serve(v);
    serve(add(add(1, 2), add(3, 4)));
    send 0;
}
