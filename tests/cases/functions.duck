// functions.duck - calls, parameters, values sent back and recursion.
wing add(a: int, b: int) -> int {
    send a + b;
}

wing fib(n: int) -> int {
    when n < 2 {
        send n;
    }
    send fib(n - 1) + fib(n - 2);
}

wing describe(name: string) -> string {
    send name;
}

wing nothing() {
    serve("nothing");
}

wing main() -> int {
    serve(add(2, 40));
    serve(fib(20));
    serve(describe("duck"));
    nothing();
    nest v = add(fib(10), fib(5));
    serve(v);
    serve(add(add(1, 2), add(3, 4)));
    send 0;
}
