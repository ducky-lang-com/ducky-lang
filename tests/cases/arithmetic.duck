// arithmetic.duck - operators, precedence and associativity.
wing add(a: int, b: int) -> int {
    send a + b;
}

wing main() -> int {
    serve(7 + 3);
    serve(7 - 3);
    serve(7 * 3);
    serve(7 / 3);
    serve(7 % 3);
    serve(-7 / 3);
    serve(-7 % 3);
    serve(2 + 3 * 4);
    serve((2 + 3) * 4);
    serve(100 / 10 / 5);
    serve(-5);
    serve(1000000 * 1000000);
    serve(1 + add(2, 3));
    serve(add(3, 4) * 2);
    send 0;
}
