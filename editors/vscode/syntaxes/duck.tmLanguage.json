{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ducky",
  "scopeName": "source.duck",
  "fileTypes": ["duck"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#function-definition" },
    { "include": "#struct-declaration" },
    { "include": "#let-declaration" },
    { "include": "#const-declaration" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtin" },
    { "include": "#function-call" },
    { "include": "#field-access" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.duck",
          "match": "//.*$"
        },
        {
          "name": "comment.block.duck",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.duck",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.duck" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.duck" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.duck",
              "match": "\\\\(n|t|r|\\\\|\")"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.duck",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.duck",
          "match": "\\b[0-9]+\\.[0-9]+([eE][-+]?[0-9]+)?\\b|\\b[0-9]+[eE][-+]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.decimal.duck",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.duck" },
            "2": { "name": "entity.name.function.duck" }
          }
        }
      ]
    },
    "struct-declaration": {
      "patterns": [
        {
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.duck" },
            "2": { "name": "entity.name.type.duck" }
          }
        }
      ]
    },
    "let-declaration": {
      "patterns": [
        {
          "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.duck" },
            "2": { "name": "variable.other.duck" }
          }
        }
      ]
    },
    "const-declaration": {
      "patterns": [
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.duck" },
            "2": { "name": "variable.other.constant.duck" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.duck",
          "match": "\\b(fn|extern|struct|import|const|let|if|else|while|for|in|send|break|continue)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.duck",
          "match": "\\b(int|float|bool|string)\\b"
        },
        {
          "name": "storage.type.duck",
          "match": "\\btensor(?=\\s*\\[)"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.duck",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "builtin": {
      "patterns": [
        {
          "name": "support.function.builtin.duck",
          "match": "\\b(serve|len|str|input_line|push|scan_int|scan_float|scan_int_line|scan_float_line|tensor|zeros|ones|rand|seed|shape|grad|step|matmul_tn|matmul_nt|matmul|sgd|momentum|adam|dot|relu|sigmoid|tanh|gelu|softmax|sum|mean|max|min|argmax|mse|cross_entropy_grad|cross_entropy)(?=\\s*\\()"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "entity.name.function.call.duck",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "field-access": {
      "patterns": [
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.duck" },
            "2": { "name": "variable.other.property.duck" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.duck",
          "match": "->|==|!=|<=|>=|&&|\\|\\||<<|>>|\\.\\.\\.|\\.\\.|[-+*/%!&|^~]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.bracket.duck",
          "match": "[\\(\\)\\{\\}\\[\\]]"
        },
        {
          "name": "punctuation.separator.duck",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.duck",
          "match": "\\."
        }
      ]
    }
  }
}
