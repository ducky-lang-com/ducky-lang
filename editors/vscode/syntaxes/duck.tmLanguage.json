{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Duck",
  "scopeName": "source.duck",
  "fileTypes": ["duck"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#function-definition" },
    { "include": "#let-declaration" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtin" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.duck",
          "match": "//.*$"
        },
        {
          "name": "comment.block.duck",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.duck",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.duck" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.duck" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.duck",
              "match": "\\\\(n|t|r|\\\\|\")"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.duck",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.duck",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(wing)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.duck" },
            "2": { "name": "entity.name.function.duck" }
          }
        }
      ]
    },
    "let-declaration": {
      "patterns": [
        {
          "match": "\\b(nest)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.duck" },
            "2": { "name": "variable.other.duck" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.duck",
          "match": "\\b(wing|nest|when|otherwise|while|send)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.duck",
          "match": "\\b(int|bool|string)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.duck",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "builtin": {
      "patterns": [
        {
          "name": "support.function.builtin.duck",
          "match": "\\b(serve)(?=\\s*\\()"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "entity.name.function.call.duck",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.duck",
          "match": "->|==|!=|<=|>=|&&|\\|\\||[-+*/%!]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.bracket.duck",
          "match": "[\\(\\)\\{\\}\\[\\]]"
        },
        {
          "name": "punctuation.separator.duck",
          "match": "[,;:]"
        }
      ]
    }
  }
}
